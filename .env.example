# Copiá a .env y completá. NUNCA commitees valores reales.
# F1 usa mocks por defecto; estas variables solo aplican en modo http (F3, bloqueado por JWT de staging).

# mock (default, datos sintéticos) | http (backend real, requiere las 2 de abajo)
NORTEX_API_MODE=mock

# Opcionales (aplican en ambos modos):
NORTEX_TENANT_ID=default
NORTEX_RATE_LIMIT_PER_MIN=30

# Solo para NORTEX_API_MODE=http:
NORTEX_API_URL=
NORTEX_SERVICE_TOKEN=
